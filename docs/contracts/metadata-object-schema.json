{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/hneyra/osc/docs/contracts/metadata-object-schema.json",
  "title": "ObjectDefinition",
  "description": "Schema for an OSC metadata object definition",
  "type": "object",
  "required": ["apiName", "label", "labelPlural"],
  "properties": {
    "apiName": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]*(__c)?$",
      "description": "Immutable API name. Custom objects must end in __c.",
      "examples": ["Account", "Project__c"]
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "description": "Human-readable singular label"
    },
    "labelPlural": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "description": "Human-readable plural label"
    },
    "isCustom": {
      "type": "boolean",
      "default": true
    },
    "fields": {
      "type": "array",
      "items": { "$ref": "#/definitions/FieldDefinition" }
    }
  },
  "definitions": {
    "FieldDefinition": {
      "type": "object",
      "required": ["apiName", "label", "fieldType"],
      "properties": {
        "apiName": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*(__c)?$",
          "description": "Immutable API name. Custom fields must end in __c."
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "fieldType": {
          "type": "string",
          "enum": [
            "TEXT", "TEXTAREA", "NUMBER", "CURRENCY", "PERCENT",
            "DATE", "DATETIME", "TIME", "BOOLEAN",
            "PICKLIST", "MULTIPICKLIST",
            "LOOKUP", "MASTER_DETAIL",
            "EMAIL", "URL", "PHONE",
            "AUTO_NUMBER", "FORMULA", "ROLLUP"
          ]
        },
        "isRequired": {
          "type": "boolean",
          "default": false
        },
        "isUnique": {
          "type": "boolean",
          "default": false
        },
        "storageKind": {
          "type": "string",
          "enum": ["JSONB", "COLUMN"],
          "default": "JSONB"
        },
        "config": {
          "type": "object",
          "description": "Type-specific configuration",
          "properties": {
            "maxLength": { "type": "integer", "minimum": 1 },
            "precision": { "type": "integer", "minimum": 0 },
            "scale": { "type": "integer", "minimum": 0 },
            "picklistValues": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["value", "label"],
                "properties": {
                  "value": { "type": "string" },
                  "label": { "type": "string" },
                  "isDefault": { "type": "boolean", "default": false }
                }
              }
            },
            "referenceTo": {
              "type": "string",
              "description": "API name of the referenced object (for LOOKUP/MASTER_DETAIL)"
            }
          }
        }
      }
    }
  }
}
